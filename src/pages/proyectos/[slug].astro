---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const proyectos = await getCollection('proyectos');
  return proyectos.map((p) => ({ params: { slug: p.id }, props: { p } }));
}
const { p } = Astro.props;
const { Content } = await render(p);
---
<Base title={`${p.data.titulo} | Sebastián Poma`} description={p.data.resumen} current="proyecto" diagramas>
  <div class="case-head">
    <a class="back" href="/#proyectos">← Todos los proyectos</a>
    <h1 style="margin-top:16px">{p.data.titulo}</h1>
    <p class="tagline">{p.data.destacado}</p>
    <ul class="tags">{p.data.etiquetas.map((t) => <li>{t}</li>)}</ul>
  </div>
  <article class="prose"><Content /></article>
</Base>
